# Ignore build artifacts in parent directory
../*.deb
../*.dsc
../*.tar.gz
../*.tar.xz
../*.changes
../*.buildinfo

# Keep releases directory .deb files
!releases/*.deb

# Debian build directories
.debhelper/
debian/.debhelper/
debian/appimage-autoinstaller/
debian/debhelper-build-stamp
debian/files
debian/*.substvars
debian/*.log
debian/*.debhelper
obj-*/

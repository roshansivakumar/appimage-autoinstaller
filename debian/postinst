#!/bin/bash

set -e

. /usr/share/debconf/confmodule

case "$1" in
    configure)
        # Get configuration values
        db_get appimage-autoinstaller/watch-directory
        WATCH_DIR="$RET"

        db_get appimage-autoinstaller/install-directory
        INSTALL_DIR="$RET"

        # Expand tilde in paths
        WATCH_DIR="${WATCH_DIR/#\~/$HOME}"
        INSTALL_DIR="${INSTALL_DIR/#\~/$HOME}"

        # Get actual user (not root if using sudo)
        if [ -n "$SUDO_USER" ]; then
            ACTUAL_USER="$SUDO_USER"
            ACTUAL_HOME=$(eval echo ~$SUDO_USER)
        else
            ACTUAL_USER="${USER:-$(whoami)}"
            ACTUAL_HOME="${HOME:-$(eval echo ~$ACTUAL_USER)}"
        fi

        # Replace USER placeholder in watch dir
        WATCH_DIR="${WATCH_DIR//\/home\/USER/$ACTUAL_HOME}"

        # Create configuration file
        cat > /etc/appimage-autoinstaller.conf <<EOF
# AppImage Auto-Installer Configuration
WATCH_DIR="$WATCH_DIR"
INSTALL_DIR="$INSTALL_DIR"
EOF

        # Create directories
        mkdir -p "$WATCH_DIR" || true
        mkdir -p "$INSTALL_DIR" || true

        # Set ownership if install dir was created in system location
        if [[ "$INSTALL_DIR" == /opt/* ]] || [[ "$INSTALL_DIR" == /usr/* ]]; then
            chown -R "$ACTUAL_USER:$ACTUAL_USER" "$INSTALL_DIR" 2>/dev/null || true
        fi

        # Create systemd user service directory
        SYSTEMD_USER_DIR="$ACTUAL_HOME/.config/systemd/user"
        mkdir -p "$SYSTEMD_USER_DIR"

        # Create systemd service file
        cat > "$SYSTEMD_USER_DIR/appimage-installer.service" <<EOF
[Unit]
Description=AppImage Auto-Installer Service
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/appimage-installer.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
EOF

        # Create systemd path file
        cat > "$SYSTEMD_USER_DIR/appimage-installer.path" <<EOF
[Unit]
Description=Watch for new AppImages in $WATCH_DIR

[Path]
PathChanged=$WATCH_DIR
Unit=appimage-installer.service

[Install]
WantedBy=default.target
EOF

        # Set ownership of systemd files
        chown -R "$ACTUAL_USER:$ACTUAL_USER" "$SYSTEMD_USER_DIR"

        # Enable and start as user (not root)
        if [ -n "$ACTUAL_USER" ]; then
            su - "$ACTUAL_USER" -c "systemctl --user daemon-reload" 2>/dev/null || true
            su - "$ACTUAL_USER" -c "systemctl --user enable appimage-installer.path" 2>/dev/null || true
            su - "$ACTUAL_USER" -c "systemctl --user start appimage-installer.path" 2>/dev/null || true
        fi

        echo ""
        echo "AppImage Auto-Installer has been configured!"
        echo "Watch directory: $WATCH_DIR"
        echo "Install directory: $INSTALL_DIR"
        echo ""
        echo "Use 'appimage-sync' to manually scan for AppImages."
        echo ""
        ;;
esac

#DEBHELPER#

exit 0
